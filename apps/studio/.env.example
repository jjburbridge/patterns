# Copy to `.env` and fill in. Find the values on https://sanity.io/manage, or
# ask someone who already has a working checkout.
#
# Only `SANITY_STUDIO_`-prefixed names reach the browser bundle, so the prefix
# is required rather than stylistic. `.env.local` is loaded after `.env` and
# overrides it; variables exported into the shell beat both.

# The Sanity project the Studio reads and writes. Required.
SANITY_STUDIO_PROJECT_ID=

# The dataset within that project, e.g. `production`. Required.
SANITY_STUDIO_DATASET=

# Where `pnpm deploy` publishes the Studio. Only the deploy command reads it;
# leave it blank and the CLI will ask.
SANITY_STUDIO_APP_ID=
